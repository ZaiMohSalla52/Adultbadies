# Public Supabase runtime variables (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional service role key for privileged server-side jobs (never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ModelsLab — primary LLM + image provider (auto-selected when key is set)
MODELSLAB_API_KEY=your-modelslab-api-key
VG_IMAGE_PROVIDER=modelslab
# VG_LLM_PROVIDER=modelslab
# VG_MODELSLAB_CHAT_MODEL=ModelsLab/Llama-3.1-8b-Uncensored-Dare
# VG_MODELSLAB_FAST_MODEL=ModelsLab/Llama-3.1-8b-Uncensored-Dare
# Portrait preview + canonical text2img (Aurelium — Phase 0 bake-off winner).
# Avoid ModelsLab `flux` / fal Flux Pro here: adult-leaning traits can black-card.
# Explicit nude chat uses flux-kontext-dev + Face Gen, NOT this model.
MODELSLAB_PORTRAIT_MODEL=aurelium-photorealistic-people-bysilas-v1-0-1771498462
# Auto-generated gallery photos per new companion (temporary credit cap)
# VIRTUAL_GIRLFRIEND_GALLERY_TARGET=2
# Gallery identity-lock img2img from canonical (Kontext Pro bake-off winner)
MODELSLAB_KONTEXT_PRO_MODEL=flux-kontext-pro
# Uncensored img2img fallback for adult chat only — not used for gallery
MODELSLAB_KONTEXT_DEV_MODEL=flux-kontext-dev
# Explicit/nude chat: face swap only (body text2img + single_face_swap, no fallbacks).
# Uncensored body scene model — public NSFW SDXL (not Aurelium; Aurelium is portrait-only).
# MODELSLAB_EXPLICIT_BODY_MODEL=cyberrealistic-xl-desire-desire-v1-0-dmd2
# Alternatives: firexxxrealisticnsfw-v10, mklan-aio-nsfw-aio-nextgen-xl, korean-nude-model-photorealism-v1-0
# Legacy SDXL img2img (non-explicit paths only):
# MODELSLAB_SDXL_MODEL=aurelium-photorealistic-people-bysilas-v1-0-1771498462
# MODELSLAB_FACE_GEN_MODEL=ai-avatar-generatorface-gen

# Together AI — fallback text LLM when MODELSLAB_API_KEY is unset
TOGETHER_API_KEY=your-together-api-key
# VG_TOGETHER_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Pro
# VG_TOGETHER_FAST_MODEL=deepseek-ai/DeepSeek-V4-Pro

# Cloudflare R2 — primary browser image delivery (use pub-*.r2.dev, NOT *.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
# Public HTTPS base — from R2 bucket Settings → Public access (pub-xxxxxxxx.r2.dev)
R2_PUBLIC_BASE_URL=https://pub-your-bucket-id.r2.dev

# Cloudinary — optional delivery fallback when R2 upload fails
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=adultbadiesvirtual-girlfriend

# Optional fal.ai Flux — emergency fallback only (set VG_IMAGE_PROVIDER=flux). Not used in Phase 1.
# FLUX_API_KEY=your-fal-api-key
# FLUX_BASE_URL=https://fal.run
# FLUX_COMPANION_MODEL=fal-ai/flux-pro/v1.1
# FLUX_COMPANION_SAFETY_TOLERANCE=5
# FLUX_MODEL=fal-ai/flux-pro/v1.1
# FLUX_KONTEXT_MODEL=fal-ai/flux-pro/kontext
# FLUX_KONTEXT_DEV_MODEL=fal-ai/flux-kontext/dev

# Virtual Girlfriend chat images — adult-capable by default on Adult Badies
VG_ALLOW_ADULT_CONTENT=true

# Test/dev premium override: comma-separated emails that resolve as premium
# without a real subscription (unlocks fresh per-request photo generation, etc.).
# Leave empty in production. Email is matched against the Supabase auth JWT.
# PREMIUM_OVERRIDE_EMAILS=topeyy@gmail.com