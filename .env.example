# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner auth user for auto-generated library companions (npm run catalog:create-system-user)
CATALOG_SYSTEM_USER_ID=

# fal.ai — portrait (flux/dev) + gallery (flux-kontext/dev) — required for seed/setup
FLUX_API_KEY=
FLUX_BASE_URL=https://fal.run

# Together AI — primary uncensored chat LLM + memory embeddings
TOGETHER_API_KEY=
# VG_TOGETHER_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Pro
# VG_TOGETHER_FAST_MODEL=deepseek-ai/DeepSeek-V4-Pro
# VG_LLM_PROVIDER=together  # together (default) | modelslab

# ModelsLab — explicit chat images only (face gen/swap; NOT portrait/gallery/chat)
MODELSLAB_API_KEY=
# VG_IMAGE_PROVIDER=modelslab  # explicit chat routing only; identity images always use fal

# Browser image delivery — required to persist portraits/gallery (no ModelsLab hosting fallback)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=