# Public Supabase runtime variables (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional service role key for privileged server-side jobs (never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Together AI — text LLM (replaces OpenAI for all chat)
TOGETHER_API_KEY=your-together-api-key
# Default: deepseek-ai/DeepSeek-V4-Pro (uncensored Dolphin mixtral is auto-fallback)
# VG_TOGETHER_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Pro
# VG_TOGETHER_FAST_MODEL=deepseek-ai/DeepSeek-V4-Pro

# Cloudflare R2 (source-of-truth originals)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name

# Cloudinary (delivery + responsive transformations)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=adultbadiesvirtual-girlfriend

# Image generation — Flux via fal.ai (sole image provider, required)
FLUX_API_KEY=your-fal-api-key
FLUX_BASE_URL=https://fal.run
FLUX_MODEL=fal-ai/flux/dev
FLUX_KONTEXT_MODEL=fal-ai/flux-pro/kontext

# Virtual Girlfriend chat images — adult-capable by default on Adult Badies
VG_ALLOW_ADULT_CONTENT=true