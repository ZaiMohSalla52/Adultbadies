# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner auth user for auto-generated library companions (npm run catalog:create-system-user)
CATALOG_SYSTEM_USER_ID=

# fal.ai — portrait (flux/dev) + gallery (flux-kontext/dev) — required
FLUX_API_KEY=
FLUX_BASE_URL=https://fal.run

# Together AI — optional (memory embeddings only; chat LLM is ModelsLab)
TOGETHER_API_KEY=

# ModelsLab — chat LLM + explicit chat images (required)
MODELSLAB_API_KEY=
# VG_MODELSLAB_CHAT_MODEL=uncensored-chat

# Browser image delivery (stops ModelsLab base64_to_url hosting charges)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=