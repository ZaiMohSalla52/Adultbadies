# Public Supabase runtime variables (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional service role key for privileged server-side jobs (never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ModelsLab — primary LLM + image provider (auto-selected when key is set)
MODELSLAB_API_KEY=your-modelslab-api-key
# VG_LLM_PROVIDER=modelslab
# VG_IMAGE_PROVIDER=modelslab
# VG_MODELSLAB_CHAT_MODEL=ModelsLab/Llama-3.1-8b-Uncensored-Dare
# VG_MODELSLAB_FAST_MODEL=ModelsLab/Llama-3.1-8b-Uncensored-Dare
# Photorealistic portrait model (avoid generic `flux` — it skews anime/stylized).
# MODELSLAB_PORTRAIT_MODEL=flux-realistic-portrait-v2-0
# MODELSLAB_FLUX_MODEL=flux-realistic-portrait-v2-0
# MODELSLAB_KONTEXT_PRO_MODEL=flux-kontext-pro
# MODELSLAB_KONTEXT_DEV_MODEL=flux-kontext-dev
# Explicit/nude chat images use SDXL img2img (safety_checker off). Use an uncensored
# checkpoint — generic `sdxl` may still moderate. Face Gen is the automatic fallback.
# MODELSLAB_SDXL_MODEL=sdxl-uncensored
# Non-explicit requested-look adult chat can still use Face Gen as fallback.
# MODELSLAB_FACE_GEN_MODEL=ai-avatar-generatorface-gen

# Together AI — fallback text LLM when MODELSLAB_API_KEY is unset
TOGETHER_API_KEY=your-together-api-key
# VG_TOGETHER_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Pro
# VG_TOGETHER_FAST_MODEL=deepseek-ai/DeepSeek-V4-Pro

# Cloudflare R2 (source-of-truth originals + recommended browser delivery)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
# Public HTTPS base for browser image URLs (R2 custom domain or *.r2.dev). Required if Cloudinary is unset.
# R2_PUBLIC_BASE_URL=https://pub-your-bucket-id.r2.dev

# Cloudinary (optional delivery fallback — transforms/responsive CDN)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=adultbadiesvirtual-girlfriend

# Image generation — fal.ai Flux fallback (used when MODELSLAB_API_KEY unset)
FLUX_API_KEY=your-fal-api-key
FLUX_BASE_URL=https://fal.run
# Companion preview/canonical text2img — Flux Pro reduces same-face collapse.
FLUX_COMPANION_MODEL=fal-ai/flux-pro/v1.1
# Flux Pro defaults to safety_tolerance=2 which blanks adult-leaning portraits to black.
FLUX_COMPANION_SAFETY_TOLERANCE=5
FLUX_MODEL=fal-ai/flux-pro/v1.1
FLUX_KONTEXT_MODEL=fal-ai/flux-pro/kontext
# Adult chat images route to the open-weights Kontext [dev] model on fal.
# FLUX_KONTEXT_DEV_MODEL=fal-ai/flux-kontext/dev

# Virtual Girlfriend chat images — adult-capable by default on Adult Badies
VG_ALLOW_ADULT_CONTENT=true

# Test/dev premium override: comma-separated emails that resolve as premium
# without a real subscription (unlocks fresh per-request photo generation, etc.).
# Leave empty in production. Email is matched against the Supabase auth JWT.
# PREMIUM_OVERRIDE_EMAILS=topeyy@gmail.com